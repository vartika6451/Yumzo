# Supabase Configuration
# 1. Sign up at https://supabase.com and create a new project.
# 2. Go to Project Settings -> API to copy your Project URL and Publishable/Anon Key.
# 3. Add them to your local .env.local or .env file (never commit your secret keys!).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# (Optional) Service Role key used exclusively by server-side seed scripts:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-seed-scripts

# Legacy MongoDB & JWT Configuration (retained for backward compatibility)
MONGO_URI=mongodb://127.0.0.1:27017/yumzo
JWT_SECRET=yumzo_super_secret_jwt_key_123456

# Stripe Simulation Configuration (optional for testing)
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_key
